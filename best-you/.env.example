# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Server ---
PORT=3000
# Public base URL of this server (used only for display/logging)
PUBLIC_URL=http://localhost:3000

# --- WhatsApp (Meta WhatsApp Business Platform / Cloud API) ---
# Leave these empty to run in "dev mode": OTPs are printed to the console,
# and you can use the browser test chat at /chat.html instead of WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The business phone number users will chat with, digits only, with country code (e.g. 15551234567)
WHATSAPP_BUSINESS_NUMBER=
# Any secret string you choose; you enter the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# App secret from your Meta app (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
# Name of an approved WhatsApp "authentication" template used to send OTP codes.
# If empty, OTPs are printed to the server console instead.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# Graph API version; check Meta's docs for the current one
WHATSAPP_API_VERSION=v21.0
